# Long-cache immutable build assets (content-hashed) and fonts
# NOTE: this repo edits chunk files IN PLACE (same filename) - never use immutable here,
# or edge PoPs and browsers keep serving stale chunks after a deploy.
/_next/static/*
  Cache-Control: public, max-age=86400

# Images - 30 day cache (stable filenames)
/*.webp
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
