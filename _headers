# Long-cache immutable build assets (content-hashed) and fonts
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images - 30 day cache (stable filenames)
/*.webp
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000

# Site injectors
/*.js
  Cache-Control: public, max-age=86400
